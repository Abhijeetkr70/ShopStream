# =========================================================
# ShopStream — environment variables (copy to .env.local)
# =========================================================

# ---- App ----
NEXT_PUBLIC_APP_NAME="ShopStream"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- Clerk (Auth) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ---- Neon Postgres (DB) ----
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---- Upstash Redis (Cache + Queues) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Razorpay (Payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Brevo (Email) ----
BREVO_API_KEY=
BREVO_FROM_EMAIL="orders@shopstream.app"
BREVO_FROM_NAME="ShopStream"

# ---- Cloudinary (Images) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ---- Backblaze B2 (Object storage) ----
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# ---- AI Providers ----
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# ---- JWT (cookie auth) ----
JWT_SECRET=
JWT_EXPIRES_IN="7d"

# ---- Security ----
CSRF_SECRET=
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4000"

# ---- Render (keep-alive) ----
RENDER_EXTERNAL_URL=
HEALTH_TOKEN=

# ---- Vercel Analytics ----
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
