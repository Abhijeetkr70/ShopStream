{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "paths": {
      "@shopstream/ui": ["./packages/ui/src/index.ts"],
      "@shopstream/ui/*": ["./packages/ui/src/*"],
      "@shopstream/db": ["./packages/db/src/index.ts"],
      "@shopstream/db/*": ["./packages/db/src/*"],
      "@shopstream/lib": ["./packages/lib/src/index.ts"],
      "@shopstream/lib/*": ["./packages/lib/src/*"],
      "@shopstream/types": ["./packages/types/src/index.ts"],
      "@shopstream/types/*": ["./packages/types/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
