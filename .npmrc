node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true
enable-pre-post-scripts=true

# Approve native build scripts that Next.js / esbuild / msgpackr-extract need
# (these were previously blocked by pnpm's IGNORED_BUILDS safety check).
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=msgpackr-extract
onlyBuiltDependencies[]=unrs-resolver
onlyBuiltDependencies[]=@clerk/shared
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=sharp
