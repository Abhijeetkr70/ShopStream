{
  "name": "shopstream",
  "version": "1.0.0",
  "private": true,
  "description": "ShopStream — Swiggy-style e-commerce, full-stack.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @shopstream/db generate",
    "db:migrate": "pnpm --filter @shopstream/db migrate",
    "db:seed": "pnpm --filter @shopstream/db seed",
    "docs": "node scripts/build-docs.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
